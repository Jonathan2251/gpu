digraph G {
  rankdir=LR;
  
  compound=true;
  node [shape=record];
  subgraph cluster_cpu {
    label = "CPU (Client)";
    CPU_SW [label=" 3D Model | Game Engine | { OpenGL API | Shaders \n (built-in functions)} | <f1> Driver"];
  }
  subgraph cluster_gpu {
    label = "GPU Hardware";
    subgraph cluster_gpu_sw {
      label = "3D Rendering Pipeline \ndescribed in a later section";
      ModelData        [label="3D Model Information\n(VAO, VBO, textures,\nindex buffers, materials)"];
    }
  }
  CPU_SW:f1 -> ModelData [label="1. Create mesh resources:\nVAO, textures, and other data from the 3D model;\ncompile shader-executable code."];
    
//  label = "Graphic SW Stack";
}
