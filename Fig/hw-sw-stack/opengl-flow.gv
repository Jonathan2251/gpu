digraph G {
  rankdir=LR;

  compound=true;
  node [shape=record];
  subgraph cluster_3d {
    label = "3D/2D Modeling Software";
    subgraph cluster_code {
      label = "3D/2D Code: Engine, Shaders, etc.";
      Api [label="<a> OpenGL API | <s> Shaders (animation shaders\nor shaders written by the programmer)"];
    }
  }
  subgraph cluster_driver {
    label = "Driver"
    Compiler [label="Online Compiler"];
    Obj [label="obj"];
    Linker [label="Online Linker"];
    Exe [label="exe"];
  }
  Api:a -> Obj [lhead ="cluster_driver"];
  Api:s -> Compiler;
  Compiler -> Obj -> Linker -> Exe;
  Exe -> GPU;
  Exe -> CPU [ltail ="cluster_driver"]; 

//  label = "OpenGL Flow";
}
