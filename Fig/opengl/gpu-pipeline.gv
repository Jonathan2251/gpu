digraph GPU_Pipeline {
    rankdir=LR;
    node [shape=box, style=rounded, fontsize=12];

    VB [label="Vertex Buffer"];
    VS [label="Vertex Shader", style=filled, fillcolor=orange];

    subgraph cluster_ts {
        label="Tessellation";
        style=rounded;

        PA  [label="Patch Assembly\n(GL_PATCHES)"];
        TCS [label="Tessellation\nControl Shader\n(optional)",
             style=filled, fillcolor=orange];
        TS  [label="Tessellator\n(fixed-function)"];
        TES [label="Tessellation\nEvaluation Shader\n(required when\n tessellation is enabled)",
             style=filled, fillcolor=orange];

        { rank = same; PA; TCS; TS; TES }
    }

    subgraph cluster_pp {
        label="Primitive Processing";
        style=rounded;

        IPA  [label="Input Primitive Assembly\n(for Geometry Shader)"];
        GS   [label="Geometry Shader\n(optional)",
              style=filled, fillcolor=orange];
        OPA  [label="Geometry Shader Output\nPrimitive Formation"];
        Clip [label="Clipping"];
        Cull [label="Face Culling"];
        PS   [label="Primitive Setup\n(rasterization prep)"];

        { rank = same; IPA; GS; OPA; Clip; Cull; PS }
    }

    RAST [label="Rasterizer"];
    FS   [label="Fragment Shader", style=filled, fillcolor=orange];
    FB   [label="Per-Fragment Operations\n& Framebuffer"];

    VB -> VS;

    // Tessellation path: VS outputs are grouped into patches first.
    VS -> PA [label="GL_PATCHES"];
    PA -> TCS [label="input patch"];
    TCS -> TS;
    PA -> TS [label="no TCS", style=dashed];
    TS -> TES;

    // The TES produces the tessellated primitive stream.
    TES -> IPA [label="tessellated primitives"];

    // Non-tessellation path.
    VS -> IPA [label="no tessellation", style=dashed];

    // A Geometry Shader receives already assembled input primitives.
    IPA -> GS [label="assembled primitives"];
    GS -> OPA;
    IPA -> Clip [label="no Geometry Shader", style=dashed];

    // GS output is interpreted according to its declared output topology.
    OPA -> Clip;
    Clip -> Cull;
    Cull -> PS;
    PS -> RAST;
    RAST -> FS;
    FS -> FB;

    { rank = same; VB; VS }
    { rank = same; RAST; FS; FB }
}
